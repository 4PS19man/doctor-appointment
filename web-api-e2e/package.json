{
  "name": "@schedula-monorepo/web-api-e2e",
  "version": "0.0.1",
  "private": true,
  "nx": {
    "implicitDependencies": [
      "@schedula-monorepo/web-api"
    ],
    "targets": {
      "e2e": {
        "executor": "@nx/jest:jest",
        "outputs": [
          "{projectRoot}/test-output/jest/coverage"
        ],
        "options": {
          "jestConfig": "web-api-e2e/jest.config.ts",
          "passWithNoTests": true
        },
        "dependsOn": [
          "@schedula-monorepo/web-api:build",
          "@schedula-monorepo/web-api:serve"
        ]
      }
    }
  }
}
